# AUTO-GENERATED by apply_theme.py — edit palette.json, not this file.
# Starship has no "include another file" directive, so unlike the others
# this template IS your whole starship.toml. Move your real config's
# content here and drop placeholder tokens (double-curly-brace syntax,
# same as the other templates) into the style strings where you want a
# themed color. Starship re-reads this file on every new prompt, so no
# reload step is needed at all.

add_newline = true

format = """
[$directory]($style)[$git_branch]($style)[$git_status](bold red)\
$line_break\
$username\
$hostname\
[$character]($style)"""

continuation_prompt = "[>](bold #{{accent}}) "

[username]
style_user = "#{{foreground}}"
style_root = "dimmed #{{accent}}"
format = '''[$user]($style)'''
disabled = false
show_always = true

[hostname]
ssh_only = false
format = '[@](#{{muted}})[$hostname](bold #{{foreground}}) '
disabled = false

[character]
success_symbol = "[>](bold #{{accent}})"
error_symbol   = "[>](bold #{{accent}})"
vimcmd_symbol  = "[<](bold #{{accent}})"

[directory]
style             = "bold #{{foreground}}"
format            = "[$path]($style)[$read_only]($read_only_style)"
read_only         = " ×"
read_only_style   = "#{{accent}}"
truncation_length = 4
truncate_to_repo  = false
home_symbol       = "~"

[git_branch]
format = " [\\(](#{{muted}})[$branch](#{{accent}})[\\)](#{{muted}})"
style  = "#{{accent}}"

[git_status]
format     = "[$all_status$ahead_behind]($style)"
style      = "bold #{{accent}}"
conflicted = "!"
ahead      = "^${count}"
behind     = "v${count}"
diverged   = "<>"
modified   = "~"
untracked  = "?"
staged     = "+"
deleted    = "-"

[nodejs]
disabled = false
format   = " [node $version](#{{muted}})"

[python]
disabled = false
format   = " [py $version](#{{muted}})"

[rust]
disabled = false
format   = " [rs $version](#{{muted}})"

[cmd_duration]
min_time = 2000
format   = " [${duration}](#{{muted}})"

[status]
disabled = false
format   = " [x $status](bold #{{accent}})"

[jobs]
disabled = false
format   = " [job:$number](#{{muted}})"

[time]
disabled    = true
format      = " [$time](#{{muted}})"
time_format = "%H:%M"

[package]
disabled = true
[aws]
disabled = true
[gcloud]
disabled = true
[azure]
disabled = true
[terraform]
disabled = true
[kubernetes]
disabled = true

